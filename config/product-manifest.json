{
  "schema_version": 1,
  "product_id": "mac-ai-work-os",
  "manifest_version": "0.1.0-dev",
  "paths": {
    "config": "${APP_SUPPORT}/config",
    "state": "${APP_SUPPORT}/state",
    "data": "${APP_SUPPORT}/data",
    "runtimes": "${APP_SUPPORT}/runtimes",
    "logs": "${APP_SUPPORT}/logs",
    "backups": "${APP_SUPPORT}/backups",
    "cache": "${CACHE}",
    "secrets": "keychain://mac-ai-work-os"
  },
  "components": [
    {
      "id": "omlx",
      "version": "v0.6.3",
      "install_mode": "verified_official_artifact",
      "runtime": "upstream_macos_app",
      "start_order": 10,
      "port": 8000,
      "health_contract": "pending-adapter-verification",
      "artifact_contract": "verified-2026-08-29-macos26",
      "shallow_health_contract": "verified-2026-08-29-empty-model-runtime",
      "deep_health_contract": "verified-qwen3-0.6b-4bit-generation-2026-08-29",
      "model_storage_contract": "verified-pinned-external-reference-2026-08-29",
      "isolation_contract": "shallow-verified-product-home-2026-08-29-full-fs-audit-pending",
      "cors_contract": "upstream-wildcard-contained-by-real-loopback-broker-shallow",
      "update_owner": "product_compatibility_gate",
      "allow_self_update": false,
      "data_path": "${APP_SUPPORT}/data/omlx"
    },
    {
      "id": "semantica",
      "version": "v0.6.7",
      "install_mode": "managed_python_environment",
      "runtime": "isolated_python_library",
      "start_order": 20,
      "port": null,
      "health_contract": "pending-adapter-verification",
      "upstream_server_contract": "rejected-fixed-port-and-shallow-health-v0.6.7",
      "update_owner": "product_compatibility_gate",
      "allow_self_update": false,
      "data_path": "${APP_SUPPORT}/data/semantica"
    },
    {
      "id": "herdr",
      "version": "v0.8.2",
      "install_mode": "verified_release_binary",
      "runtime": "native_binary",
      "start_order": 30,
      "port": null,
      "health_contract": "pending-adapter-verification",
      "update_owner": "product_compatibility_gate",
      "allow_self_update": false,
      "data_path": "${APP_SUPPORT}/data/herdr"
    },
    {
      "id": "holaos",
      "version": "latest",
      "install_mode": "external_user_install_pending_license_clearance",
      "runtime": "external_electron_app",
      "start_order": 40,
      "port": null,
      "health_contract": "pending-adapter-verification",
      "update_owner": "product_compatibility_gate",
      "allow_self_update": false,
      "data_path": "external-user-managed"
    }
  ],
  "product_services": [
    {
      "id": "inference-broker",
      "port": 43110,
      "bind_policy": "loopback-only",
      "contract": "verified-synthetic-loopback",
      "real_upstream_contract": "verified-pinned-omlx-qwen3-generation-2026-08-29",
      "resource_contract": "verified-synthetic-admission-and-bounds",
      "max_request_bytes": 1048576,
      "max_response_bytes": 8388608,
      "max_concurrent_requests": 16,
      "max_concurrent_inference": 2,
      "inference_requests_per_minute": 30,
      "upstream_timeout_seconds": 30,
      "secret_policy": "keychain-runtime-injection"
    },
    {
      "id": "governed-memory-service",
      "port": 43111,
      "bind_policy": "loopback-only",
      "contract": "verified-service-process-and-synthetic-lifecycle-2026-08-30",
      "semantica_contract": "verified-agent-context-v0.6.7-no-network-boundary",
      "embedding_contract": "unavailable-until-approved-local-route",
      "secret_policy": "keychain-runtime-injection"
    }
  ],
  "lifecycle": {
    "install_steps": [
      "preflight",
      "consent",
      "prepare_directories",
      "acquire_artifacts",
      "verify_artifacts",
      "configure_components",
      "start_components",
      "verify_sample_workflow"
    ],
    "uninstall_steps": [
      "stop_components",
      "export_or_preserve_user_data",
      "remove_managed_runtimes",
      "remove_managed_configuration",
      "finalize"
    ]
  }
}
